{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["**", "!!node_modules", "!!dist", "!!site/orb-graph.bundle.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "includes": ["site/**/*.ts", "site/**/*.css", "src/**/*.ts", "src/**/*.js", "scripts/**/*.mjs"],
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "nursery": {
        "noReturnInFinally": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "site/ui/**",
        "site/components/**",
        "src/domain/**",
        "src/application/**",
        "src/projection/**"
      ],
      "linter": {
        "rules": {
          "preset": "all",
          "nursery": {
            "preset": "recommended"
          }
        }
      }
    }
  ]
}
