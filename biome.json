{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!dist",
      "!!test-results",
      "!!playwright-report",
      "!!blob-report",
      "!!site/orb-graph.bundle.js",
      "!!site/evidence-extraction.bundle.js",
      "!!site/leaflet.bundle.js",
      "!!site/leaflet.css",
      "!!site/pdf.worker.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "includes": [
      "site/**/*.ts",
      "site/**/*.js",
      "site/**/*.css",
      "src/**/*.ts",
      "src/**/*.js",
      "scripts/**/*.mjs",
      "tests/**/*.mjs",
      "benchmarks/**/*.mjs",
      "*.config.ts"
    ],
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useGenericFontNames": "error"
      },
      "complexity": {
        "noImportantStyles": "error"
      },
      "style": {
        "noDescendingSpecificity": "error",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noShorthandPropertyOverrides": "error",
        "noUnknownAtRules": "error"
      },
      "nursery": {
        "noExcessiveSelectorClasses": "error",
        "noReturnInFinally": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "site/ui/**",
        "site/components/**",
        "src/domain/**",
        "src/application/**",
        "src/projection/**"
      ],
      "linter": {
        "rules": {
          "preset": "all",
          "nursery": {
            "preset": "recommended"
          }
        }
      }
    }
  ]
}
