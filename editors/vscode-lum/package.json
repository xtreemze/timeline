{
  "name": "lum-language-tools",
  "displayName": "Lūm Language Tools",
  "description": "Strict schema validation, diagnostics, formatting, scaffolding, and semantic highlighting for Lūm projects and change proposals.",
  "version": "0.1.0",
  "publisher": "xtreemze",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "workspaceContains:**/*.lum.json",
    "onCommand:lum.checkCurrentFile",
    "onCommand:lum.lintCurrentFile",
    "onCommand:lum.initProject"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": [
          "*.lum.json",
          "**/*.lum.json"
        ],
        "url": "https://xtreemze.github.io/timeline/schemas/lum-project-v1.schema.json"
      },
      {
        "fileMatch": [
          "*.lum-proposal.json",
          "**/*.lum-proposal.json"
        ],
        "url": "https://xtreemze.github.io/timeline/schemas/lum-change-proposal-v1.schema.json"
      }
    ],
    "commands": [
      {
        "command": "lum.checkCurrentFile",
        "title": "Lūm: Check Current Project"
      },
      {
        "command": "lum.lintCurrentFile",
        "title": "Lūm: Lint Current Project"
      },
      {
        "command": "lum.initProject",
        "title": "Lūm: Initialize Project"
      }
    ],
    "configuration": {
      "title": "Lūm",
      "properties": {
        "lum.cliPath": {
          "type": "string",
          "default": "lum",
          "description": "Path to the Lūm CLI. When left as 'lum', the extension first looks for this repository's scripts/lum.mjs in the workspace."
        },
        "lum.validateOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Run strict Lūm lint diagnostics while editing .lum.json files."
        }
      }
    },
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/lum.code-snippets"
      }
    ]
  }
}
