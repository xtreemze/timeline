{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["./biome.json"],
  "linter": {
    "rules": {
      "style": {
        "noDescendingSpecificity": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/site/spatial-shell.css", "**/site/timeline-view.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
