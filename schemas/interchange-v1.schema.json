{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtreemze.github.io/timeline/schemas/interchange-v1.schema.json",
  "title": "Timeline External Interchange v1",
  "description": "A vendor-neutral event, period, grouping, story, entity, and relationship interchange envelope used by Timeline adapters.",
  "type": "object",
  "required": [
    "title",
    "groups",
    "events",
    "periods",
    "_timeline"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "periods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "_timeline": {
      "type": "object",
      "required": [
        "format",
        "schemaVersion",
        "generatedBy",
        "canonicalVersion"
      ],
      "properties": {
        "format": {
          "const": "timeline-interchange"
        },
        "schemaVersion": {
          "const": 1
        },
        "generatedBy": {
          "type": "string"
        },
        "canonicalVersion": {
          "type": "integer"
        },
        "stories": {
          "type": "array"
        },
        "note": {
          "type": "string"
        },
        "entities": {
          "type": "array"
        },
        "relationships": {
          "type": "array"
        },
        "evidence": {
          "type": "array"
        },
        "reasoning": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "date"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "number",
            "object"
          ]
        },
        "group": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "relationChanges": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "period": {
      "type": "object",
      "required": [
        "id",
        "title",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "start": {
          "type": [
            "string",
            "number",
            "object"
          ]
        },
        "end": {
          "type": [
            "string",
            "number",
            "object"
          ]
        },
        "group": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "relationChanges": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
