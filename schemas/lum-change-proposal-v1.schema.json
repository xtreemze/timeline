{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtreemze.github.io/timeline/schemas/lum-change-proposal-v1.schema.json",
  "title": "Lūm Change Proposal v1",
  "description": "Strict, reviewable proposed changes to a specific Lūm project revision. A proposal is not canonical project state and always requires verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "version",
    "projectKey",
    "expectedRevision",
    "verificationRequired",
    "instruction",
    "unresolvedFacts",
    "operations"
  ],
  "properties": {
    "$schema": {
      "const": "https://xtreemze.github.io/timeline/schemas/lum-change-proposal-v1.schema.json"
    },
    "format": {
      "const": "lum-change-proposal"
    },
    "version": {
      "const": 1
    },
    "projectKey": {
      "type": "string",
      "minLength": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1
    },
    "verificationRequired": {
      "const": true
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "unresolvedFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedFact"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "generation": {
      "$ref": "#/$defs/generation"
    }
  },
  "$defs": {
    "unresolvedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/createEntity"
        },
        {
          "$ref": "#/$defs/replaceEntity"
        },
        {
          "$ref": "#/$defs/createRelationship"
        },
        {
          "$ref": "#/$defs/replaceRelationship"
        },
        {
          "$ref": "#/$defs/createOccurrence"
        },
        {
          "$ref": "#/$defs/replaceOccurrence"
        },
        {
          "$ref": "#/$defs/createTrajectory"
        },
        {
          "$ref": "#/$defs/replaceTrajectory"
        },
        {
          "$ref": "#/$defs/createPlace"
        },
        {
          "$ref": "#/$defs/replacePlace"
        },
        {
          "$ref": "#/$defs/createSource"
        },
        {
          "$ref": "#/$defs/replaceSource"
        },
        {
          "$ref": "#/$defs/createCategory"
        },
        {
          "$ref": "#/$defs/replaceCategory"
        },
        {
          "$ref": "#/$defs/createStory"
        },
        {
          "$ref": "#/$defs/replaceStory"
        },
        {
          "$ref": "#/$defs/deleteOperation"
        }
      ]
    },
    "createEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "entities"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/entity"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replaceEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "entities"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/entity"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "createRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "relationships"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/relationship"
        },
        "composerSentence": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replaceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "relationships"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/relationship"
        },
        "composerSentence": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "createOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "occurrences"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/occurrence"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replaceOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "occurrences"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/occurrence"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "createTrajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "trajectories"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/trajectory"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replaceTrajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "trajectories"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/trajectory"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "deleteOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "id"],
      "properties": {
        "op": {
          "const": "delete"
        },
        "collection": {
          "enum": [
            "entities",
            "relationships",
            "occurrences",
            "trajectories",
            "places",
            "sources",
            "categories",
            "stories"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "createPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "places"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/place"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replacePlace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "places"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/place"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "createSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "sources"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/source"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replaceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "sources"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/source"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "createCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "categories"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/category"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replaceCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "categories"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/category"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "createStory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "create"
        },
        "collection": {
          "const": "stories"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/story"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "replaceStory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "collection", "record"],
      "properties": {
        "op": {
          "const": "replace"
        },
        "collection": {
          "const": "stories"
        },
        "record": {
          "$ref": "lum-project-v1.schema.json#/$defs/story"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    }
  }
}
