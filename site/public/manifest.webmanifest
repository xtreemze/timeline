{
  "id": "./",
  "name": "Lūm",
  "short_name": "Lūm",
  "description": "Weave people, places, actions, evidence, and stories into a navigable continuum.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#111111",
  "orientation": "any",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./pwa-icon-512.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./pwa-maskable-512.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".luum"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Add event",
      "short_name": "Add event",
      "description": "Open the Lūm event editor",
      "url": "./?shortcut=new-event",
      "icons": [
        {
          "src": "./pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Browse timeline",
      "short_name": "Browse",
      "description": "Open the Lūm timeline browser",
      "url": "./?shortcut=browse",
      "icons": [
        {
          "src": "./pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
