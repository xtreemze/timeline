{
  "extends": "./tsconfig.migrated.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "src/projection/**/*.ts",
    "src/layout/**/*.ts",
    "src/interaction/**/*.ts"
  ]
}
